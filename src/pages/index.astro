---
import Analytics from "../components/Analytics.astro";
import "../styles/global.css";

const quickCheckUrl =
  "https://02signal.ai/et/kiirkontroll/?utm_source=automatiseerimine.ee&utm_medium=microsite&utm_campaign=automatiseerimine";
const emailHref =
  "mailto:info@02signal.ai?subject=Automatiseerimine.ee%20-%20t%C3%BC%C3%BCtu%20t%C3%B6%C3%B6";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://automatiseerimine.ee/#organization",
      name: "Automatiseerimine.ee",
      legalName: "Ettevõtluskeskus OÜ",
      url: "https://automatiseerimine.ee/",
      email: "info@02signal.ai",
      telephone: "+37258180435"
    },
    {
      "@type": "Service",
      "@id": "https://automatiseerimine.ee/#service",
      name: "Korduvate tööde automatiseerimise nõu väikeettevõttele",
      serviceType: "Äri automatiseerimine, töövoogude lihtsustamine, AI abiline",
      provider: { "@id": "https://automatiseerimine.ee/#organization" },
      areaServed: "EE",
      audience: {
        "@type": "Audience",
        audienceType: "Eesti mikro- ja väikeettevõtte omanikud"
      },
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "EUR",
        lowPrice: 0,
        highPrice: 3900
      },
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Automatiseerimise esimesed sammud",
        itemListElement: [
          {
            "@type": "Offer",
            name: "Kiirkontroll",
            price: "0",
            priceCurrency: "EUR"
          },
          {
            "@type": "Offer",
            name: "Omaniku nõu",
            priceSpecification: {
              "@type": "PriceSpecification",
              minPrice: "490",
              priceCurrency: "EUR"
            }
          },
          {
            "@type": "Offer",
            name: "Stardiplaan",
            priceSpecification: {
              "@type": "PriceSpecification",
              minPrice: "1900",
              priceCurrency: "EUR"
            }
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://automatiseerimine.ee/#faq",
      mainEntity: [
        {
          "@type": "Question",
          name: "Millist tööd tasub esimesena automatiseerida?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Hea esimene töö kordub sageli, kasutab juba olemasolevat infot ja inimene saab tulemuse enne kasutamist üle vaadata."
          }
        },
        {
          "@type": "Question",
          name: "Kas väikeettevõte peab kohe suure süsteemi ostma?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Ei. Tihti piisab alguses lihtsast vormist, teavitusest, tabeli korrastamisest või AI mustandist, mida inimene kontrollib."
          }
        }
      ]
      }
  ]
};
---

<!doctype html>
<html lang="et">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Automatiseerimine.ee | Vähem käsitööd väikeettevõttes</title>
    <meta
      name="description"
      content="Lihtsas keeles abi Eesti väikeettevõtte omanikule: leiame ühe korduva töö, mida saab automatiseerida või AI abil lihtsamaks teha."
    />
    <link rel="canonical" href="https://automatiseerimine.ee/" />
    <meta property="og:title" content="Automatiseerimine.ee | Vähem käsitööd väikeettevõttes" />
    <meta
      property="og:description"
      content="Näidake meile ühte tüütut korduvat tööd. Ütleme maakeeli, kas seda saab lihtsamaks teha ja mis see võiks maksta."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://automatiseerimine.ee/" />
    <meta property="og:image" content="https://automatiseerimine.ee/hero-automatiseerimine.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <Analytics />
  </head>
  <body>
    <header class="topbar">
      <nav class="nav" aria-label="Põhinavigeerimine">
        <a class="brand" href="/">Automatiseerimine.ee</a>
        <div class="navlinks">
          <a href="#mured">Mured</a>
          <a href="#kontroll">Kontroll</a>
          <a href="#kuidas">Kuidas käib</a>
          <a href="#hinnad">Hinnad</a>
          <a href="/korduv-too/">Korduv töö</a>
          <a href="/excelist-automaatseks/">Excel</a>
          <a href="/faq/">FAQ</a>
          <a href="#kontakt">Kontakt</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-inner">
          <span class="eyebrow">Vähem käsitööd. Rohkem rahu.</span>
          <h1>Mis töö võtab teil iga nädal asjatult aega?</h1>
          <p>
            Pakkumised, e-kirjad, tellimused, aruanded, Excelid või meeldetuletused.
            Näidake meile ühte tüütut tööd ja ütleme maakeeli, kas seda saab lihtsamaks teha.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href={quickCheckUrl} data-track-event="quick_check_click" data-track-label="hero_quick_check">Tee 10 min tasuta kontroll</a>
            <a class="btn btn-secondary" href="tel:+37258180435" data-track-event="phone_click" data-track-label="hero_phone">Helista +372 5818 0435</a>
          </div>
          <div class="proof">
            <div><strong>Kordub</strong><span>sama päring, sama tabel, sama meeldetuletus</span></div>
            <div><strong>Segab</strong><span>omanik või töötaja peab iga kord käsitsi sekkuma</span></div>
            <div><strong>Lihtsustub</strong><span>vorm, teavitus või AI mustand teeb esimese sammu</span></div>
          </div>
          <div class="automation-strip" aria-label="Automatiseerimise lihtne voog">
            <span>Päring</span>
            <strong>→</strong>
            <span>Kontroll</span>
            <strong>→</strong>
            <span>Teavitus</span>
            <strong>→</strong>
            <span>Inimene kinnitab</span>
          </div>
        </div>
      </section>

      <section id="mured" class="white">
        <div class="section-inner">
          <div class="section-head">
            <span class="kicker">Kust tavaliselt alustame</span>
            <h2>Kui inimene teeb sama asja kümneid kordi, on seal tihti lihtne võit.</h2>
            <p>
              Me ei alusta tehnoloogiast. Alustame küsimusest: milline töö võtab aega,
              kordub sageli ja on piisavalt lihtne, et inimene saab tulemust üle vaadata?
            </p>
          </div>
          <div class="grid-3">
            <article class="card">
              <div class="number">1</div>
              <h3>Pakkumised ja vastused</h3>
              <p>Kliendile vastuse või pakkumise esimene mustand valmib kiiremini, inimene vaatab üle.</p>
              <a href="/korduv-too/" data-track-event="cta_click" data-track-label="card_repeated_work">Vaata korduva töö näiteid</a>
            </article>
            <article class="card">
              <div class="number">2</div>
              <h3>Excel ja kopeerimine</h3>
              <p>Andmeid ei pea iga kord käsitsi ühest kohast teise tõstma.</p>
              <a href="/excelist-automaatseks/" data-track-event="cta_click" data-track-label="card_excel">Vaata Exceli näiteid</a>
            </article>
            <article class="card">
              <div class="number">3</div>
              <h3>Meeldetuletused ja teavitused</h3>
              <p>Töö ei jää seisma ainult sellepärast, et keegi unustas kellelegi kirjutada.</p>
              <a href="/faq/" data-track-event="cta_click" data-track-label="card_faq">Loe lihtsad küsimused</a>
            </article>
          </div>
        </div>
      </section>

      <section id="kontroll" class="white">
        <div class="section-inner tool-grid">
          <div>
            <span class="kicker">Kiire kontroll</span>
            <h2>Kas seda tööd tasub automaatseks teha?</h2>
            <p>
              Vastake viiele lihtsale küsimusele. Tulemus ei ole lõplik otsus, aga annab omanikule
              selge tunde, kas kõne või väike plaan on mõistlik.
            </p>
            <ul class="check">
              <li>hea esimene töö kordub sageli</li>
              <li>inimene saab alguses tulemuse üle vaadata</li>
              <li>viga ei tohi kohe kalliks minna</li>
            </ul>
          </div>

          <div class="tool-card" data-automation-tool>
            <div class="tool-questions">
              <label>
                <span>Kas sama töö kordub iga nädal?</span>
                <select data-auto-question>
                  <option value="2">Jah</option>
                  <option value="1">Mõnikord</option>
                  <option value="0">Ei</option>
                </select>
              </label>
              <label>
                <span>Kas sisend on tavaliselt sarnane?</span>
                <select data-auto-question>
                  <option value="2">Jah</option>
                  <option value="1">Osaliselt</option>
                  <option value="0">Ei</option>
                </select>
              </label>
              <label>
                <span>Kas inimene saab vastuse enne kasutamist üle vaadata?</span>
                <select data-auto-question>
                  <option value="2">Jah</option>
                  <option value="1">Mõnikord</option>
                  <option value="0">Ei</option>
                </select>
              </label>
              <label>
                <span>Kas vea kahju on alguses kontrollitav?</span>
                <select data-auto-question>
                  <option value="2">Jah</option>
                  <option value="1">Vajab kokkulepet</option>
                  <option value="0">Ei</option>
                </select>
              </label>
              <label>
                <span>Kas üks vastutaja saab öelda, mis on õige tulemus?</span>
                <select data-auto-question>
                  <option value="2">Jah</option>
                  <option value="1">Võib-olla</option>
                  <option value="0">Ei</option>
                </select>
              </label>
            </div>
            <button class="btn btn-primary" type="button" data-auto-calculate>Näita tulemust</button>
            <div class="tool-result" data-auto-result>
              <span class="tag">Näidis</span>
              <h3>Sobib esimeseks kontrolliks</h3>
              <p>Kui vastus on enamasti “jah”, on tõenäoliselt olemas väike töö, mida saab lihtsamaks teha.</p>
            </div>
            <div class="inline-actions">
              <a class="btn btn-light" href={quickCheckUrl} data-track-event="quick_check_click" data-track-label="automation_tool_quick_check">Tee 10 min kontroll</a>
              <a class="btn btn-secondary dark" href="tel:+37258180435" data-track-event="phone_click" data-track-label="automation_tool_phone">Helista</a>
            </div>
          </div>
        </div>
      </section>

      <section id="kuidas" class="green">
        <div class="section-inner">
          <div class="section-head">
            <span class="kicker">Lihtne tööviis</span>
            <h2>Kolm sammu enne, kui midagi ehitame.</h2>
            <p>See hoiab ära olukorra, kus kulutate raha tööriistale, mida keegi hiljem ei kasuta.</p>
          </div>
          <div class="steps">
            <div class="step"><strong>01</strong><div><h3>Nimetame tüütu töö ära</h3><p>Mis võtab aega? Kes teeb? Kui tihti? Mis on tulemus?</p></div></div>
            <div class="step"><strong>02</strong><div><h3>Kontrollime, kas seda saab lihtsustada</h3><p>Kas info on olemas, viga ei ole liiga kallis ja inimene saab tulemuse üle vaadata?</p></div></div>
            <div class="step"><strong>03</strong><div><h3>Ütleme ausalt järgmise sammu</h3><p>Kas teha väike abiline, alustada stardiplaanist või jätta praegu tegemata.</p></div></div>
          </div>
        </div>
      </section>

      <section id="hinnad" class="white">
        <div class="section-inner">
          <div class="section-head">
            <span class="kicker">Hind peab olema arusaadav</span>
            <h2>Alustame väikese riskiga.</h2>
          </div>
          <div class="grid-3">
            <article class="card price">
              <h3>Kiirkontroll</h3>
              <p>Saate esmase pildi, kas teie töös on automatiseerimise koht.</p>
              <strong>0 €</strong>
              <ul class="check"><li>10 minutit</li><li>tulemus kohe ekraanil</li><li>hea ettevalmistus kõneks</li></ul>
            </article>
            <article class="card price">
              <h3>Omaniku nõu</h3>
              <p>Vaatame 2-3 tüütut tööd läbi ja anname selge soovituse.</p>
              <strong>490 € + KM</strong>
              <ul class="check"><li>90 min kohtumine</li><li>üks soovitatud esimene töö</li><li>hinnavahemik ja riskid</li></ul>
            </article>
            <article class="card price">
              <h3>Stardiplaan</h3>
              <p>Kui kohti on mitu, valime ühe mõistliku alguse ja paneme plaani kirja.</p>
              <strong>al 1 900 € + KM</strong>
              <ul class="check"><li>korduvate tööde kaart</li><li>mida teha ja mida vältida</li><li>järgmine ehituse samm</li></ul>
            </article>
          </div>
        </div>
      </section>

      <section id="kontakt" class="green">
        <div class="section-inner contact">
          <div>
            <span class="kicker">Räägime konkreetselt</span>
            <h2>Näidake ühte tööd, mis teid praegu tüütab.</h2>
            <p>
              Kui seda ei ole mõistlik automatiseerida, ütleme seda kohe. Kui on mõistlik,
              pakume väikese ja kontrollitava esimese sammu.
            </p>
            <div class="inline-actions">
              <a class="btn btn-primary" href={quickCheckUrl} data-track-event="quick_check_click" data-track-label="contact_quick_check">Tee tasuta kontroll</a>
              <a class="btn btn-secondary" href="tel:+37258180435" data-track-event="phone_click" data-track-label="contact_phone">Helista +372 5818 0435</a>
            </div>
          </div>
          <aside class="contact-card">
            <h3>Kirjutage otse</h3>
            <p>Ettevõtluskeskus OÜ / 02Signal</p>
            <p><a href={emailHref} data-track-event="email_click" data-track-label="contact_email">info@02signal.ai</a></p>
            <p><a href="tel:+37258180435" data-track-event="phone_click" data-track-label="contact_card_phone">+372 5818 0435</a></p>
          </aside>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <strong>Automatiseerimine.ee</strong>
        <span>
          Ettevõtluskeskus OÜ · kanal 02Signal praktilisse töövoogu ·
          <a href="/korduv-too/">Korduv töö</a> ·
          <a href="/excelist-automaatseks/">Excelist automaatseks</a> ·
          <a href="/faq/">FAQ</a> ·
          <a href="/privaatsus/">Privaatsus</a>
        </span>
      </div>
    </footer>

    <script is:inline>
      const automationTool = document.querySelector("[data-automation-tool]");
      const automationResult = document.querySelector("[data-auto-result]");
      const automationButton = document.querySelector("[data-auto-calculate]");
      let automationToolStarted = false;

      const trackAutomation = (eventName, params = {}) => {
        if (typeof window.automatiseerimineTrack === "function") {
          window.automatiseerimineTrack(eventName, {
            source_site: "automatiseerimine.ee",
            ...params
          });
        }
      };

      const resultByScore = (score) => {
        if (score >= 8) {
          return {
            tier: "sobib",
            title: "Sobib väikeseks automaatikaks",
            text: "See töö kordub piisavalt ja inimene saab alguses tulemust kontrollida. Järgmine samm on kirjeldada töö täpselt ära ja hinnata lihtne lahendus."
          };
        }
        if (score >= 5) {
          return {
            tier: "vajab_tapsustamist",
            title: "Tasub enne täpsustada",
            text: "Mõte võib olla hea, aga enne ehitamist tuleb selgeks teha vastutaja, vea piir ja see, kust info tuleb."
          };
        }
        return {
          tier: "mitte_esimene",
          title: "Praegu mitte esimene valik",
          text: "Seda tööd ei tasu tõenäoliselt esimesena automatiseerida. Alustage lihtsamast korduvast tööst, kus kontroll on selgem."
        };
      };

      automationTool?.addEventListener("change", () => {
        if (automationToolStarted) return;
        automationToolStarted = true;
        trackAutomation("tool_start", {
          tool_name: "automation_suitability_check"
        });
      });

      automationButton?.addEventListener("click", () => {
        const questions = Array.from(document.querySelectorAll("[data-auto-question]"));
        const score = questions.reduce((sum, input) => sum + Number(input.value || 0), 0);
        const result = resultByScore(score);

        if (automationResult) {
          automationResult.innerHTML = `
            <span class="tag">Tulemus: ${score}/10</span>
            <h3>${result.title}</h3>
            <p>${result.text}</p>
          `;
        }

        trackAutomation("tool_completed", {
          tool_name: "automation_suitability_check",
          result_score: score,
          result_tier: result.tier
        });

        if (result.tier === "sobib") {
          trackAutomation("result_high_intent", {
            tool_name: "automation_suitability_check",
            result_score: score,
            result_tier: result.tier
          });
        }
      });
    </script>
  </body>
</html>
